# ── AI vrstva (Ollama Cloud) ─────────────────────────────────────────────
# API klíč pro Ollama Cloud (https://ollama.com). Bez něj /api/ask vrací 503.
OLLAMA_API_KEY=

# ── Google Analytics 4 ──────────────────────────────────────────────────
# Measurement ID z GA4 (Administration → Data Streams → Web).
# Formát: G-XXXXXXXXXX. Bez něj se <GoogleAnalytics /> nevykreslí (no-op).
# Ve Vercelu nastavit pro Production I Preview.
NEXT_PUBLIC_GA_ID=

# ── Feedback form (Resend) ──────────────────────────────────────────────
# API klíč z https://resend.com/api-keys. Bez něj /api/feedback vrací 503.
# Klíč má být "Sending access only" — nepotřebuje práva na čtení.
RESEND_API_KEY=

# Komu chodí nahlášení z webu.
FEEDBACK_TO_EMAIL=

# Odesílatel. Dokud není doména v Resend ověřená, musí být onboarding@resend.dev
# (a příjemce musí být e-mail vlastníka účtu). Po ověření domény změnit na
# např. "4rap <feedback@4rap.cz>".
FEEDBACK_FROM_EMAIL=
